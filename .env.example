# ---------------------------------------------------------------------------
# Variables de entorno de scanner-app (API de procesado de tiques)
#
# Copia este archivo a `.env.local` y rellena los valores:
#     cp .env.example .env.local
# `.env.local` está en .gitignore: NUNCA subas claves reales a git.
# ---------------------------------------------------------------------------

# Clave de API de OpenRouter (obligatoria).
# Cómo obtenerla:
#   1. Regístrate en https://openrouter.ai (Google, GitHub o email).
#   2. Abre https://openrouter.ai/keys y pulsa "Create Key".
#   3. Copia la clave (empieza por `sk-or-v1-…`) y pégala aquí.
# Sin esta clave, POST /api/process-receipt responde 500.
OPENROUTER_API_KEY=

# Modelo de visión usado para leer el tique (opcional).
# Debe aceptar imágenes como entrada. Los IDs con sufijo `:free` son
# gratuitos (límite de peticiones diarias) y valen solo para pruebas.
# Listado vigente: https://openrouter.ai/models?order=newest&q=free
#   - dots-studio/dots-3-note-preview:free  → valor por defecto.
#       Único modelo gratuito con visión que además soporta
#       `structured_outputs` (response_format json_schema estricto).
#   - google/gemma-4-31b-it:free            → alternativa (solo json_object).
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Endpoint de chat completions (opcional).
# Por defecto se usa https://openrouter.ai/api/v1/chat/completions.
# Úsalo para apuntar a otro endpoint compatible con la API de OpenRouter
# (p. ej. un proxy o gateway propio).
OPENROUTER_BASE_URL=
